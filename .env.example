# Ciabatta Tools -- copy to .env and fill in.
#
#     cp .env.example .env
#
# .env is gitignored. Never commit real values: this repository is public, and a
# leaked BOT_TOKEN or TG_API_HASH means rotating both.

# --- required -----------------------------------------------------------------
# The bot refuses to start without these, and names the ones that are missing.

# @BotFather -> /newbot
BOT_TOKEN=

# my.telegram.org -> API development tools. NOT the bot token: gifts are read as
# a user over MTProto, which a bot cannot do. Both are needed.
TG_API_ID=
TG_API_HASH=

# 64 hex characters. Encrypts session strings and API keys at rest:
#     python3 -c "import secrets; print(secrets.token_hex(32))"
# Losing this makes every stored session unreadable -- everyone logs in again.
CIABATTA_SECRET_KEY=

# Public https address of the mini-app, no trailing slash. Telegram rejects a
# WebApp button whose URL is not https, so http here means no button at all.
PUBLIC_URL=

# --- important ----------------------------------------------------------------

# Your Telegram id; unlocks /keys. Find it via @userinfobot.
OWNER_TG_ID=

# Simulation mode. true = nothing is ever bought. Leave it true until the whole
# flow has been checked once -- this is the line between testing and spending.
DRY_RUN=true

SUPPORT_CONTACT=@awhoreable

# --- optional -----------------------------------------------------------------

# Defaults to SQLite under ./data, which is what the Docker volume mounts. For
# Postgres:  postgresql+asyncpg://user:pass@host:5432/ciabatta
DATABASE_URL=

# The host usually injects these.
PORT=8080
HOST=0.0.0.0

# Spending limits in TON, enforced per purchase and per day. They apply whether
# or not DRY_RUN is off.
MAX_SPEND_PER_BUY_TON=5
MAX_SPEND_PER_DAY_TON=50

# MRKT token, if supplying one by hand. Normally empty: it is obtained through
# your own Telegram session.
MRKT_TOKEN=

# TLS fingerprint profile for curl_cffi. MRKT drops clients whose handshake does
# not look like a browser; change only if requests start being refused outright.
MRKT_IMPERSONATE=chrome124

# Seconds between MRKT requests, per process. Lower values invite 429s -- the
# client handles them, but everything slows down.
MRKT_MIN_INTERVAL=0.55

# How long a signed initData payload stays acceptable, in seconds. This is what
# stops a captured payload being replayed indefinitely.
INITDATA_MAX_AGE_SEC=3600

# Redis for the floor cache and the cross-process rate-limit token. Optional:
# without it each process keeps its own cache.
REDIS_URL=

# --- bot-detection guard (auto-ordering) --------------------------------------
# A rival bot outbidding in a tight loop turns auto-ordering into a bidding war
# that only ends when the budget does. If an order is outbid ANTIBOT_OUTBID_LIMIT
# times inside ANTIBOT_WINDOW_SEC, the job stops.
ANTIBOT_ENABLED=true
ANTIBOT_OUTBID_LIMIT=3
ANTIBOT_WINDOW_SEC=60
# pause = resume after ANTIBOT_PAUSE_SEC; stop = full halt needing a manual start.
ANTIBOT_ACTION=pause
ANTIBOT_PAUSE_SEC=900

# --- economics ----------------------------------------------------------------
# TON gas per side of a trade. Not a fee we charge -- it is what the network
# takes, and on a 2-5 TON gift it exceeds the market's own 2% cut. Profit
# calculations subtract both sides, which is why "no commission" is not "free".
GAS_BUY_TON=0.1
GAS_SELL_TON=0.1
# MRKT's cut, as a fraction.
MRKT_FEE=0.02

# --- polling ------------------------------------------------------------------
# The tracker polls, because Telegram pushes no update for gifts that are not
# yours. Lower is faster but burns rate-limit budget; on FLOOD_WAIT the interval
# backs off up to TRACKER_POLL_BACKOFF_MAX.
TRACKER_POLL_INTERVAL=4.0
TRACKER_POLL_BACKOFF_MAX=60
# Sniping scans new listings on MRKT.
MRKT_POLL_INTERVAL=5.0
# Collection floors move slowly, so they are refreshed far less often.
COLLECTIONS_INTERVAL=300
FLOOR_CACHE_TTL=60
# Seconds to wait out a 429 before retrying, and the per-request timeout.
MRKT_COOLDOWN=12
MRKT_TIMEOUT=20

# --- misc ---------------------------------------------------------------------
# Bot username without @, used to build mini-app deep links.
BOT_USERNAME=
# Gift Satellite base URL. The key itself is not set here -- it is sent to the
# bot with /gskey and stored encrypted.
GIFT_SATELLITE_API=
# DEBUG logs every MRKT request. Useful when the private API changes shape,
# noisy otherwise.
LOG_LEVEL=INFO
